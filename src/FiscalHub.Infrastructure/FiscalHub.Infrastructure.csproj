<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FiscalHub.Application\FiscalHub.Application.csproj" />
    <ProjectReference Include="..\FiscalHub.Domain\FiscalHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- Pin temporário: o Microsoft.Data.SqlClient 6.1.1 traz o Pkcs 9.0.4, com GHSA-846f-f764-76mx e
         GHSA-2fmv-rv2c-59x7 (negação de serviço). Remover quando o SqlClient trouxer 9.0.21 ou maior
         transitivamente — confira com o `dotnet list package`, com a opção include-transitive (o XML não
         aceita o traço duplo dentro de comentário). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <!-- Cofre dos segredos de conector (ADR-0027): o mesmo SecretClient em dev (emulador) e em produção (Key Vault). -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiscalHub.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
