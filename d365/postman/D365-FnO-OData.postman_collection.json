              "const n = Array.isArray(j.value) ? j.value.length : -1;",
              "console.log('[FiscalHub] ' + nome + ' -> HTTP ' + pm.response.code + ' | linhas: ' + n);",
              "",
              "if (n === 0) {",
              "  console.warn('[FiscalHub] ' + nome + ' voltou 0 linhas. Duas causas possiveis:');",
              "  console.warn('  1) o ambiente realmente nao tem dado para essa entidade;');",
              "  console.warn('  2) algum data source aninhado da entidade esta em InnerJoin e esta zerando o resultado.');",
              "}"
            ]
          }
        }
