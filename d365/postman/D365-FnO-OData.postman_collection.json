  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Token (manual)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                },
                {
                  "key": "resource",
                  "value": "{{environmentUrl}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{loginUrl}}/{{tenantId}}/oauth2/token",
              "host": [
                "{{loginUrl}}"
              ],
              "path": [
                "{{tenantId}}",
                "oauth2",
                "token"
              ]
            },
            "description": "Obtém um token do Entra ID (Azure AD) via client_credentials (v1.0, resource = URL do ambiente F&O). O script de Test salva o access_token nas variáveis da collection. Normalmente você NÃO precisa rodar isso manualmente — o pre-request da collection já faz automático."
          }
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "if (j.access_token) {",
              "  pm.collectionVariables.set('access_token', j.access_token);",
              "  const exp = j.expires_on ? Number(j.expires_on) * 1000 : (Date.now() + Number(j.expires_in || 3600) * 1000);",
              "  pm.collectionVariables.set('token_expires_at', String(exp));",
              "  console.log('[D365] Token salvo. Expira em ' + new Date(exp).toISOString());",
              "}",
              "pm.test('Recebeu access_token', function () { pm.expect(j.access_token, 'sem access_token na resposta').to.be.a('string'); });"
            ]
          }
        }
      ],
      "description": "Obtencao manual do token. Normalmente nao e necessario: o pre-request da collection ja faz automatico."
    },
