                  "key": "$top",
                  "value": "{{top}}"
                }
              ]
            },
            "description": "Consulta qualquer entidade pelo nome (variável {{entityName}}). cross-company=true traz de todas as empresas; sem isso, só a empresa default da sessão."
          }
        },
