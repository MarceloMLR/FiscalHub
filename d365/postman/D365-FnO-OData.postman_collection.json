              ],
              "path": [
                "data",
                "{{entityName}}"
              ],
              "query": [
                {
                  "key": "cross-company",
                  "value": "true"
                },
                {
                  "key": "$filter",
                  "value": "dataAreaId eq '{{company}}'"
                },
                {
                  "key": "$top",
                  "value": "{{top}}"
                }
              ]
            },
            "description": "Filtra por empresa. Ex.: no FiscosysDev os dados fiscais de teste estão na empresa 'brmf' (a 'DAT' está vazia)."
          }
        },
        {
          "name": "$count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{environmentUrl}}/data/{{entityName}}/$count?cross-company=true",
              "host": [
                "{{environmentUrl}}"
              ],
              "path": [
                "data",
                "{{entityName}}",
                "$count"
              ],
              "query": [
                {
                  "key": "cross-company",
                  "value": "true"
                }
              ]
            },
            "description": "Conta registros da entidade (todas as empresas)."
          }
        }
      ],
