{
  "info": {
    "_postman_id": "b7f1a2c0-9d3e-4a6b-9e21-fiscalhub0d365",
    "name": "D365 F&O OData — FiscalHub",
    "description": "Consulta de data entities do Dynamics 365 Finance & Operations via OData.\n\n- URL do ambiente em variável (`environmentUrl`).\n- Token do Entra ID (OAuth2 client_credentials) obtido AUTOMATICAMENTE por um pre-request script na collection e reaproveitado até expirar.\n- Requests prontos: $metadata, service document, query genérica por entidade, filtro por empresa (dataAreaId), $count, e exemplos das entidades do FiscalHub.\n\nAntes de usar: preencha `tenantId`, `clientId`, `clientSecret` e `environmentUrl` (no Environment 'FiscosysDev' ou nas variáveis da collection). Veja o README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-obtem um token do Entra ID (client_credentials) se estiver ausente ou perto de expirar.",
          "const now = Date.now();",
          "const expiresAt = Number(pm.collectionVariables.get('token_expires_at') || 0);",
          "const hasToken = pm.collectionVariables.get('access_token');",
          "const needToken = !hasToken || now > (expiresAt - 60000);",
          "if (needToken) {",
          "  const tenantId = pm.variables.get('tenantId');",
          "  const clientId = pm.variables.get('clientId');",
          "  const clientSecret = pm.variables.get('clientSecret');",
          "  const resource = pm.variables.get('environmentUrl');",
          "  const loginUrl = pm.variables.get('loginUrl') || 'https://login.microsoftonline.com';",
          "  if (!tenantId || !clientId || !clientSecret || !resource) {",
          "    console.log('[D365] Preencha tenantId, clientId, clientSecret e environmentUrl no Environment do Postman.');",
          "  } else {",
          "    pm.sendRequest({",
          "      url: loginUrl + '/' + tenantId + '/oauth2/token',",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "      body: { mode: 'urlencoded', urlencoded: [",
          "        { key: 'grant_type', value: 'client_credentials' },",
          "        { key: 'client_id', value: clientId },",
          "        { key: 'client_secret', value: clientSecret },",
          "        { key: 'resource', value: resource }",
          "      ] }",
          "    }, function (err, res) {",
          "      if (err) { console.log('[D365] Erro ao obter token', err); return; }",
          "      let j = {};",
          "      try { j = res.json(); } catch (e) {}",
          "      if (j && j.access_token) {",
          "        pm.collectionVariables.set('access_token', j.access_token);",
          "        const exp = j.expires_on ? Number(j.expires_on) * 1000 : (now + (Number(j.expires_in || 3600) * 1000));",
          "        pm.collectionVariables.set('token_expires_at', String(exp));",
          "        console.log('[D365] Token novo obtido. Expira em ' + new Date(exp).toISOString());",
          "      } else {",
          "        console.log('[D365] Falha ao obter token: ' + res.text());",
          "      }",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
