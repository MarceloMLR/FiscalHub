                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{environmentUrl}}/data/{{entityName}}?cross-company=true&$filter=dataAreaId eq '{{company}}'&$top={{top}}",
              "host": [
